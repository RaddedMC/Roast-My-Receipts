{
  "manifest_version": 3,
  "name": "Roastii: Roast My Receipts!",
  "version": "0.6.7",
  "description": "Get roasted by Roastii before you regret your Amazon.ca purchases.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.ca/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.ca/*"],
      "js": ["content/amazon.js"],
      "css": ["components/roast-modal.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [  
  {  
    "resources": ["assets/svg/roastii-anger-1.png", "assets/svg/roastii-anger-2.svg", "assets/svg/roastii-anger-3.svg", "assets/svg/roastii-excite.svg", "assets/svg/roastii-meh.svg", "assets/svg/roastii-think.svg"],
    "matches": ["<all_urls>"]
  }  
  ],  
  "options_page": "options/options.html"
}
